# Neo4j settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# PostgreSQL stores LangGraph checkpoints and doctor-scoped chat memory.
POSTGRES_URI=postgresql://healthcare:healthcare@localhost:5432/healthcare
POSTGRES_DB=healthcare
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare
POSTGRES_PORT=5432
MEMORY_RECENT_TURNS=6
MEMORY_SUMMARY_TRIGGER_TURNS=12
MEMORY_SUMMARY_MAX_CHARS=4000
MEMORY_CONTEXT_MAX_CHARS=16000
# Tune to the organization's legal/audit retention policy.
MEMORY_RAW_RETENTION_DAYS=90

# LangSmith tracing
# Keep false unless external tracing is explicitly approved for sensitive data.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=HealthcareGraphRAG
LANGCHAIN_API_KEY=your_langsmith_api_key_here
# Logging
LOG_LEVEL=INFO
MAX_RESULT_ROWS=20
# Tavily is optional and used only by the admin discovery command.
TAVILY_API_KEY=your_tavily_api_key_here
MEDICAL_SEARCH_MAX_RESULTS=3
MEDICAL_SEARCH_MIN_SCORE=0.5
MEDICAL_SEARCH_CACHE_TTL_SECONDS=300
MEDICAL_SEARCH_RATE_LIMIT_PER_MINUTE=10
MEDICAL_SEARCH_DAILY_BUDGET=1000
MEDICAL_SEARCH_MAX_RETRIES=1
MEDICAL_SEARCH_MAX_RETRY_DELAY_SECONDS=2
MEDICAL_SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
MEDICAL_SEARCH_CIRCUIT_COOLDOWN_SECONDS=60
# Curated guideline answer path
CURATED_GUIDELINE_DB_PATH=data/curated_guidelines.sqlite3
CURATED_EMBEDDING_ENDPOINT=https://models.github.ai/inference
CURATED_EMBEDDING_MODEL=openai/text-embedding-3-small
CURATED_RETRIEVAL_TOP_K=3
CURATED_RETRIEVAL_MIN_SCORE=0.45
# GitHub token
GITHUB_TOKEN=your_github_token_here
