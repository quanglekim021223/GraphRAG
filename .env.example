# Neo4j settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=HealthcareGraphRAG
LANGCHAIN_API_KEY=your_langsmith_api_key_here
# Logging
LOG_LEVEL=INFO
MAX_RESULT_ROWS=20
# Allowlisted medical guideline search (optional; tool fails closed if absent)
TAVILY_API_KEY=your_tavily_api_key_here
MEDICAL_SEARCH_MAX_RESULTS=3
MEDICAL_SEARCH_MIN_SCORE=0.5
MEDICAL_SEARCH_CACHE_TTL_SECONDS=300
MEDICAL_SEARCH_RATE_LIMIT_PER_MINUTE=10
MEDICAL_SEARCH_DAILY_BUDGET=1000
MEDICAL_SEARCH_MAX_RETRIES=1
MEDICAL_SEARCH_MAX_RETRY_DELAY_SECONDS=2
MEDICAL_SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
MEDICAL_SEARCH_CIRCUIT_COOLDOWN_SECONDS=60
# GitHub token
GITHUB_TOKEN=your_github_token_here
